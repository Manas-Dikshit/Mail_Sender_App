# ---- Admin login (single account, no signup/roles) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
# Local only. In production use the bare origin with NO pathname: a path such as
# "https://site.example/login" makes next-auth infer basePath="/login" and every
# /api/auth/* endpoint fails with 400 "Bad request." (lib/auth.ts pins basePath).
NEXTAUTH_URL=http://localhost:3000

# ---- Zoho Mail SMTP ----
ZOHO_EMAIL=you@yourdomain.com
ZOHO_APP_PASSWORD=zoho-app-specific-password
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

