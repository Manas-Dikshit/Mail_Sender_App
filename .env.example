# ---- Admin login (single account, no signup/roles) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000

# ---- Zoho Mail SMTP ----
ZOHO_EMAIL=you@yourdomain.com
ZOHO_APP_PASSWORD=zoho-app-specific-password
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

# ---- SMTP verification tuning (optional) ----
# Used by recipient mailbox verification (MX host probing), not Zoho sending.
SMTP_PROBE_TIMEOUT_MS=8000
SMTP_PROBE_ATTEMPTS=3
SMTP_PROBE_RETRY_BASE_DELAY_MS=350
