# ---- Admin login (single account, no signup/roles) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
# Local only. In production use the bare origin with NO pathname: a path such as
# "https://site.example/login" makes next-auth infer basePath="/login" and every
# /api/auth/* endpoint fails with 400 "Bad request." (lib/auth.ts pins basePath).
NEXTAUTH_URL=http://localhost:3000

# ---- Zoho Mail SMTP ----
ZOHO_EMAIL=you@yourdomain.com
ZOHO_APP_PASSWORD=zoho-app-specific-password
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

# ---- Fixed CC on every outgoing email (required) ----
# Added to every sent email's CC header. Read server-side only from
# process.env.EMAIL_CC; never exposed to the frontend or overridable by the CSV
# recipient list or template placeholders. Must be a valid email address.
EMAIL_CC=your-email@example.com

# ---- {{name}} personalization fallback (optional) ----
# What {{name}} becomes when a recipient has no name (e.g. the uploaded file has
# no name column). Resolved per context so the subject never silently reads
# "Hello there, ...". Both are optional; the defaults below are applied if unset.
#   NAME_FALLBACK_BODY    -> body greeting fallback (default: "there")
#   NAME_FALLBACK_SUBJECT -> subject fallback (default: empty string)
# NAME_FALLBACK_BODY=there
# NAME_FALLBACK_SUBJECT=

